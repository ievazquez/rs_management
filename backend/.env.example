# Database
DATABASE_URL=postgresql://user:password@localhost:5432/social_media_manager

# JWT Secret
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Redis (para Celery)
REDIS_URL=redis://localhost:6379/0

# Facebook OAuth
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
FACEBOOK_REDIRECT_URI=http://localhost:3000/callback/facebook

# Instagram (usa Facebook Graph API)
INSTAGRAM_APP_ID=your-instagram-app-id
INSTAGRAM_APP_SECRET=your-instagram-app-secret
INSTAGRAM_REDIRECT_URI=http://localhost:3000/callback/instagram

# Twitter/X OAuth 2.0
TWITTER_CLIENT_ID=your-twitter-client-id
TWITTER_CLIENT_SECRET=your-twitter-client-secret
TWITTER_REDIRECT_URI=http://localhost:3000/callback/twitter

# API Keys (OAuth 1.0a para Twitter si es necesario)
TWITTER_API_KEY=your-twitter-api-key
TWITTER_API_SECRET=your-twitter-api-secret
TWITTER_BEARER_TOKEN=your-twitter-bearer-token

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# App Config
DEBUG=True
HOST=0.0.0.0
PORT=8000
